; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="FlapyBirdIntegrado"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Skins="*res://scripts/skins.gd"

[display]

window/size/viewport_width=288
window/size/viewport_height=512
window/size/window_width_override=432
window/size/window_height_override=768
window/stretch/mode="viewport"

[gui]

theme/default_font_antialiasing=0
theme/custom_font="res://assets/fonts/PressStart2P-Regular.ttf"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
